# Токен администратора (единственный пользователь шлюза). Если пусто —
# генерируется при старте и записывается в файл .admin_token (0600) рядом
# с БД (или в текущей директории). В логи не пишется. Обязателен для продакшена.
ADMIN_TOKEN=

# Доступ к opencode-серверу.
OPENCODE_BASE_URL=http://opencode-server:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=

# Параметры сессий по умолчанию.
OPENCODE_MODEL=
# Запасные модели через запятую (provider/model). При недоступности основной
# перебираются по порядку; если все недоступны — запрос идёт без модели
# (используется дефолтная модель opencode).
OPENCODE_MODEL_FALLBACK=
OPENCODE_AGENT=build
PERMISSION_MODE=ask
OPENCODE_REQUEST_TIMEOUT=30m

# Порт HTTP-сервера и рабочая директория (для загруженных файлов).
PORT=8080
WORKSPACE_DIR=/workspace

# Уровень логов: debug | info | warn | error.
LOG_LEVEL=info